@inproceedings{naitbelaidSDRANBasedApproach2022,
	address = {Rio de Janeiro, Brazil},
	title = {{SD}-{RAN} based {Approach} for {Smart} {Grid} {Critical} {Traffic} {Routing} and {Scheduling} in {5G} {Mobile} {Networks}},
	isbn = {978-1-6654-3540-6},
	url = {https://ieeexplore.ieee.org/document/10000861/},
	doi = {10.1109/GLOBECOM48099.2022.10000861},
	abstract = {Future mobile networks (5G, Beyond 5G, 6G) are expected to be used in smart grids to enable new smart grid Protection, Automation, and Control (PAC) solutions. Specifically, new Fault location, Isolation, and service Recovery (FLISR) functions have been proposed to improve the reactivity and the coordination of the grid defense lines. However, both connectivity and energy consumption remain the major challenges. Indeed, protection assets need to communicate with FLISR functions with critical communication requirements ranging from best-effort to ultra-Reliable Low-Latency Communication (uRLLC) services. Besides these connectivity challenges, the energy consumption of modern telecommunication networks is highly critical. In this context, we present in this paper an energy-efficient framework for joint routing and link scheduling of FLISR traffic in 5G mobile networks. To achieve this, we formulate the problem as an integer linear program (ILP) and present an optimal solution to solve it. Our objective is to find the best trade-off between the achieved network throughput and energy consumption, while ensuring the latency constraint of FLISR traffic. Our approach is compliant with the Software-Defined Radio Access Network (SD-RAN) paradigm since it can be integrated as a control flow application on top of an SD-RAN controller. Through extensive simulations, we show that our proposed approach achieves significant gains in terms of energy consumption, flow acceptance and achieved network throughput, compared to baseline routing strategies.},
	language = {en},
	urldate = {2023-09-19},
	booktitle = {{GLOBECOM} 2022 - 2022 {IEEE} {Global} {Communications} {Conference}},
	publisher = {IEEE},
	author = {Nait Belaid, Mohand Ouamer and Audebert, Vincent and Deneuville, Boris and Langar, Rami},
	month = dec,
	year = {2022},
	pages = {5874--5879},
}

@inproceedings{fuSDNControllerDeployment2021,
	address = {Hangzhou, China},
