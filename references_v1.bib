@article{jakariaResiliencyAwareDeploymentSDN2021,
	title = {Resiliency-{Aware} {Deployment} of {SDN} in {Smart} {Grid} {SCADA}: {A} {Formal} {Synthesis} {Model}},
	volume = {18},
	issn = {1932-4537, 2373-7379},
	shorttitle = {Resiliency-{Aware} {Deployment} of {SDN} in {Smart} {Grid} {SCADA}},
	url = {https://ieeexplore.ieee.org/document/9317839/},
	doi = {10.1109/TNSM.2021.3050148},
	abstract = {The supervisory control and data acquisition (SCADA) network in a smart grid requires to be reliable and efﬁcient to transmit real-time data to the controller, especially when the system is under contingencies or cyberattacks. Introducing the features of software-deﬁned networks (SDN) into a SCADA network helps in better management of communication and deployment of novel grid control operations. Unfortunately, it is impossible to transform the overall smart grid network to have only SDN-enabled devices overnight because of budget and logistics constraints, which raises the requirement of a systematic deployment methodology. In this article, we present a framework, named SDNSynth, that can design a hybrid network consisting of both legacy forwarding devices and programmable SDN-enabled switches. The design satisﬁes the resiliency requirements of the SCADA network, which are determined with respect to a set of pre-identiﬁed threat vectors. The resiliency-aware SDN deployment plan primarily includes the best placements of the SDN-enabled switches (replacing the legacy switches). The plan may include one or more links to be installed newly to provide ﬂexible or alternate routing paths. We design and implement the SDNSynth framework that includes the modeling of the SCADA topology, SDN-based resiliency measures, resiliency threats, mitigation requirements, the deployment budget, and other constraints. It uses satisﬁability modulo theories (SMT) for encoding the synthesis model and solving it. We demonstrate SDNSynth on a case study of an example small-scale network. We also evaluate SDNSynth on different synthetic SCADA systems and analyze how different parameters impact each other. We simulate the SDNSynth suggested networks in a Mininet environment, which demonstrate the effectiveness of the deployment strategy over traditional networks and randomly deployed SDN switches in terms of packet loss and recovery time during network congestions.},
	language = {en},
	number = {2},
	urldate = {2023-09-14},
	journal = {IEEE Transactions on Network and Service Management},
	author = {Jakaria, A. H. M. and Rahman, Mohammad Ashiqur and Gokhale, Aniruddha},
	month = jun,
	year = {2021},
	pages = {1430--1444},
}

@inproceedings{wuResearchImprovement5G2021,
	address = {Xiamen, China},
	title = {Research and improvement of {5G} wireless heterogeneous network routing protocol in smart grid application scenarios},
	isbn = {978-1-6654-3944-2},
	url = {https://ieeexplore.ieee.org/document/9538909/},
	doi = {10.1109/ICCCWorkshops52231.2021.9538909},
	abstract = {Ad hoc has the characteristics of multi hop routing, decentralized control and so on, and has strong self-organization. It can effectively combine with 5G smart grid to realize flexible deployment and coverage. AODV routing protocol is widely used in AODV network, but because it is based on the shortest path algorithm, with the increase of network load, it will lead to network congestion and performance degradation. In order to solve the above problems, this paper fully considers the impact of link quality and network load on mobile ad hoc networks, and designs a routing protocol RC-AODV based on link congestion handling. The algorithm calculates the load of the node as the measure of the congestion of the node, establishes the backup route in the process of route discovery, and takes the congestion of the node as one of the criteria to establish the route. At the same time, in the process of data packet transmission, by judging the congestion of nodes, avoiding the congestion nodes, reducing the packet loss of the network, to a certain extent, it can alleviate the congestion of the network and improve the performance of the network. Finally, the NS-2 simulation platform is used to analyze the impact of node residence time and maximum mobile speed on the performance of routing protocol. By selecting the change of end-to-end average transmission delay, it shows that this scheme can effectively alleviate network congestion, reduce network delay and improve network performance.},
	language = {en},
	urldate = {2023-09-19},
	booktitle = {2021 {IEEE}/{CIC} {International} {Conference} on {Communications} in {China} ({ICCC} {Workshops})},
	publisher = {IEEE},
	author = {Wu, Dong and Xiaojin, Chen and Guoyi, Zhang and Dili, Peng and Qing, Liu},
	month = jul,
	year = {2021},
	pages = {331--336},
}

